# ==============================================================================
# Environment Configuration Template: To-Do List Application
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=production

# Server Port (used by NGINX / Docker container and local reverse proxy)
PORT=80

# Application Metadata
APP_TITLE="To-Do List Application"
APP_VERSION=1.0.0

# Optional API Backend URL (if integrated with a future REST / GraphQL service)
API_BASE_URL=

# Feature Toggles
ENABLE_VOICE_COMMANDS=true

# AWS Deployment Configuration Variables (for local scripts / CI)
AWS_REGION=us-east-1
AWS_ECR_REPOSITORY=todo-list-app
AWS_ECS_CLUSTER=todo-app-cluster
AWS_ECS_SERVICE=todo-app-service

